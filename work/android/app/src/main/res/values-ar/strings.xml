    <!-- ==================================================== protection control -->
    <string name="guard_title">حساسية الحماية</string>
    <string name="guard_summary">مدى تشدُّد فحص المحتوى في رفض المادة التي ليس متأكدًا منها.</string>
    <string name="guard_value">%1$d</string>
    <!-- The LOW end of the dial. -->
    <string name="guard_end_low">الأقل حساسية</string>
    <!-- The HIGH end of the dial. -->
    <string name="guard_end_high">الأعلى حساسية</string>
    <string name="guard_slider_cd">حساسية الحماية، %1$d من 100</string>
    <string name="guard_note">هذا يرفع أو يخفض عتبة واحدة فقط: كم يجب أن ترتفع درجة المحتوى قبل أن يرفضه الفحص. لا يوقف الفحص أبدًا، ولا يُضعِف القواعد الإلزامية، ولا يلغي موافقتك.</string>
    <string name="guard_note_adjustable">قابل للتعديل: عتبة درجة المحتوى، ونسبة الفيديو المحجوب المسموحة.</string>
    <string name="guard_note_mandatory">غير قابل للتعديل: فحص المحتوى نفسه، وقاعدة أن الفحص الفاشل يرفض المادة، ونسبة الفيديو المحجوب المسموحة، وإقرار الموافقة، وكل قواعد الاستخدام المحظور.</string>

    <!-- ==================================================== NSFW mode -->
    <string name="nsfw_mode_title">وضع المحتوى الإباحي</string>
    <string name="nsfw_mode_summary">ما إذا كان التطبيق مسموحًا له بمعالجة محتوى إباحي تملك حق معالجته.</string>
    <string name="nsfw_mode_off">إيقاف</string>
    <string name="nsfw_mode_on">تشغيل</string>
    <string name="nsfw_mode_cd">وضع المحتوى الإباحي، %1$s</string>
    <string name="nsfw_mode_off_note">يرفض فحص المحتوى كل ما يصنّفه. ومؤشر الحساسية لا يزيده إلا تشددًا.</string>
    <string name="nsfw_mode_on_note">لا يزال فحص المحتوى يعمل في كل المسارات، ولا يزال يرفض كل ما يطمئن النموذج إلى أنه صريح. لكنه يرفض أقل مما لا يطمئن النموذج بشأنه، فالمحتوى الإباحي الذي تملك حق معالجته لا يُرفض.</string>
    <string name="nsfw_mode_rules">لا يوقف التشغيل فحص المحتوى، ولا يجعل الفحص الفاشل يمر، ولا يغيّر قواعد الموافقة ولا قواعد التعامل مع أشخاص حقيقيين ولا قواعد حماية القاصرين. واستخدامه على مادة لا تملك حق معالجتها غير مسموح، وأنت مسؤول عن ذلك.</string>
    <string name="nsfw_mode_responsibility">أنت مسؤول عن امتلاكك حق معالجة المادة، وعن القانون في بلدك.</string>
